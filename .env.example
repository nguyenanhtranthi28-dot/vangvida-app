# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env lên Git.
PORT=3000
# Khóa API Anthropic cho AI gợi ý mẫu (T02). Để trống thì ứng dụng dùng luật dự phòng.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Tài khoản nhận tiền cho mã QR VietQR (sau T09). Để trống thì dùng tài khoản demo không có thật.
VIETQR_BANK_ID=970436
VIETQR_ACCOUNT=
VIETQR_ACCOUNT_NAME=VANG VIDA JEWELRY
