<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Old_AND" targetNamespace="https://vangvida.example/asis/old-and" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_Old_AND">
    <bpmn:participant id="Participant_Total" name="Quy trình tổng thể mua bán Vangvida" processRef="Process_Old_AND" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Old_AND" name="AS-IS Vangvida bổ sung xử lý ngoại lệ" isExecutable="false">
    <bpmn:documentation>Bản bổ sung cho mục 2.3, dựa trực tiếp trên BPMN người dùng cung cấp. Nhánh thông thường và các task gốc được giữ. Ba ngoại lệ là phương án đề xuất: nhắc khi task gia công còn hoạt động tới hạn, lỗi xác nhận lưu POS, hủy đã được cửa hàng chấp thuận trước bàn giao. Điều kiện/thời điểm phải được ghi nhận khi triển khai; chưa cấu hình hay chạy BIMP cho bản ngoại lệ.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Old_AND">
      <bpmn:lane id="Lane_workshop" name="Bộ phận gia công / chế tác">
        <bpmn:flowNodeRef>W01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Overdue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_staff" name="Cửa hàng">
        <bpmn:flowNodeRef>S03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GCustom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_POS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2_Exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2_Temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel_Subprocess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_customer" name="Khách hàng">
        <bpmn:flowNodeRef>C01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GBuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndYes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:manualTask id="C01" name="Yêu cầu tư vấn">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="S03" name="Tra giá và tồn kho trên Pancake POS">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GStock" name="Có sẵn đúng ni?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="S05" name="Đo và kiểm tra lại ni">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S06" name="Đưa mẫu khách thử">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="JStock" name="">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="C02" name="Thử và xem mẫu">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="C03" name="Hỏi giá sản phẩm">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S07" name="Báo giá cho khách">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="C04" name="Xem xét giá">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GBuy" name="Khách mua?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndNo" name="Kết thúc tư vấn: không mua">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="C05" name="Cung cấp thông tin cá nhân">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="S08" name="Nhập thông tin khách hàng">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="S09" name="Tạo đơn trên POS">
      <bpmn:documentation>Quy trình con: thực hiện lưu đơn, kiểm tra xác nhận; không xác nhận được thì ném POS_SAVE_UNCONFIRMED. Cần kiểm tra đã lưu trước khi thử lại để tránh trùng đơn.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>E2_Retry</bpmn:incoming>
      <bpmn:outgoing>E2_Main</bpmn:outgoing>
      <bpmn:startEvent id="POS_Start" name="Bắt đầu tạo đơn">
        <bpmn:outgoing>POS_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="POS_Create" name="Thực hiện lưu đơn trên POS">
        <bpmn:incoming>POS_F1</bpmn:incoming>
        <bpmn:outgoing>POS_F2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="POS_Check" name="Đã nhận xác nhận lưu?">
        <bpmn:incoming>POS_F2</bpmn:incoming>
        <bpmn:outgoing>POS_F3</bpmn:outgoing>
        <bpmn:outgoing>POS_F4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="POS_Ok" name="Đã lưu đơn">
        <bpmn:incoming>POS_F3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="POS_Error" name="Không xác nhận lưu được">
        <bpmn:incoming>POS_F4</bpmn:incoming>
        <bpmn:errorEventDefinition id="POS_Throw_Error" errorRef="Error_POS_Save" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="POS_F1" name="" sourceRef="POS_Start" targetRef="POS_Create" />
      <bpmn:sequenceFlow id="POS_F2" name="" sourceRef="POS_Create" targetRef="POS_Check" />
      <bpmn:sequenceFlow id="POS_F3" name="Có" sourceRef="POS_Check" targetRef="POS_Ok" />
      <bpmn:sequenceFlow id="POS_F4" name="Không" sourceRef="POS_Check" targetRef="POS_Error" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GCustom" name="Cần chế tác thêm?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="S10" name="Gửi bộ phận gia công xưởng hỗ trợ">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="W01" name="Tiếp nhận yêu cầu kỹ thuật">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S11" name="Thu tiền cọc">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="W02" name="Tiến hành gia công">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Wait" name="Chờ theo lịch hẹn">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Wait_Timer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="S12" name="Nhận sản phẩm hoàn thiện">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="JGoods" name="">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="AND_Split">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="S13" name="Đóng gói sản phẩm">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S14" name="Xuất hóa đơn">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="AND_Join">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="C06" name="Thanh toán đơn hàng">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="C07" name="Nhận sản phẩm">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_0858uhn</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:dataObjectReference id="DataOrder" name="Đơn hàng POS" dataObjectRef="DataOrder_Object" />
    <bpmn:dataObject id="DataOrder_Object" />
    <bpmn:startEvent id="Start" name="Nhu cầu mua trang sức">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="S01" name="Tư vấn mẫu mã">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S02" name="Đo ni tay cho khách">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S04" name="Tư vấn mẫu tương tự">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S15" name="Chụp ảnh gửi nội bộ">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:dataObjectReference id="DataPhoto" name="Ảnh báo cáo nội bộ" dataObjectRef="DataPhoto_Object" />
    <bpmn:dataObject id="DataPhoto_Object" />
    <bpmn:endEvent id="EndYes" name="Hoàn tất mua hàng">
      <bpmn:incoming>Flow_0858uhn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="C01" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="C01" targetRef="S01" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="S02" targetRef="S03" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="S03" targetRef="GStock" />
    <bpmn:sequenceFlow id="Flow_6" name="Không" sourceRef="GStock" targetRef="S04" />
    <bpmn:sequenceFlow id="Flow_7" name="Có" sourceRef="GStock" targetRef="S05" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="S05" targetRef="S06" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="S06" targetRef="JStock" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="S04" targetRef="JStock" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="JStock" targetRef="C02" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="C02" targetRef="C03" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="C03" targetRef="S07" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="S07" targetRef="C04" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="C04" targetRef="GBuy" />
    <bpmn:sequenceFlow id="Flow_16" name="Không" sourceRef="GBuy" targetRef="EndNo" />
    <bpmn:sequenceFlow id="Flow_17" name="Mua" sourceRef="GBuy" targetRef="C05" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="C05" targetRef="S08" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="S08" targetRef="S09" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="E2_Join" targetRef="GCustom" />
    <bpmn:sequenceFlow id="Flow_21" name="Không cần" sourceRef="GCustom" targetRef="JGoods" />
    <bpmn:sequenceFlow id="Flow_22" name="Cần" sourceRef="GCustom" targetRef="S10" />
    <bpmn:sequenceFlow id="Flow_23" name="" sourceRef="S10" targetRef="W01" />
    <bpmn:sequenceFlow id="Flow_24" name="" sourceRef="W01" targetRef="S11" />
    <bpmn:sequenceFlow id="Flow_25" name="" sourceRef="S11" targetRef="W02" />
    <bpmn:sequenceFlow id="Flow_26" name="" sourceRef="W02" targetRef="Wait" />
    <bpmn:sequenceFlow id="Flow_27" name="" sourceRef="Wait" targetRef="S12" />
    <bpmn:sequenceFlow id="Flow_28" name="" sourceRef="S12" targetRef="JGoods" />
    <bpmn:sequenceFlow id="Flow_29" name="" sourceRef="JGoods" targetRef="AND_Split" />
    <bpmn:sequenceFlow id="Flow_30" name="" sourceRef="AND_Split" targetRef="S13" />
    <bpmn:sequenceFlow id="Flow_31" name="" sourceRef="AND_Split" targetRef="S14" />
    <bpmn:sequenceFlow id="Flow_32" name="" sourceRef="S13" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_33" name="" sourceRef="S14" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_34" name="" sourceRef="AND_Join" targetRef="C06" />
    <bpmn:sequenceFlow id="Flow_35" name="" sourceRef="C06" targetRef="S15" />
    <bpmn:sequenceFlow id="Flow_36" name="" sourceRef="S15" targetRef="C07" />
    <bpmn:sequenceFlow id="Flow_0858uhn" sourceRef="C07" targetRef="EndYes" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="S01" targetRef="S02" />
    <bpmn:boundaryEvent id="Boundary_Overdue" name="E1 · Đến hạn mà chưa hoàn thành" cancelActivity="false" attachedToRef="W02">
      <bpmn:outgoing>E1_F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Overdue_Def">
        <bpmn:timeDate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${thoiDiemHenHoanThanh}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:manualTask id="E1_Check" name="Liên hệ xưởng kiểm tra tiến độ">
      <bpmn:incoming>E1_F1</bpmn:incoming>
      <bpmn:outgoing>E1_F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="E1_Notify" name="Thông báo tình trạng chậm cho khách">
      <bpmn:incoming>E1_F2</bpmn:incoming>
      <bpmn:outgoing>E1_F3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E1_End" name="Kết thúc nhánh nhắc">
      <bpmn:incoming>E1_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="E1_F1" name="" sourceRef="Boundary_Overdue" targetRef="E1_Check" />
    <bpmn:sequenceFlow id="E1_F2" name="" sourceRef="E1_Check" targetRef="E1_Notify" />
    <bpmn:sequenceFlow id="E1_F3" name="" sourceRef="E1_Notify" targetRef="E1_End" />
    <bpmn:boundaryEvent id="Boundary_POS" name="E2 · Không xác nhận lưu đơn" attachedToRef="S09">
      <bpmn:outgoing>E2_F1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="POS_Catch_Error" errorRef="Error_POS_Save" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="E2_Check" name="Kiểm tra đơn đã lưu trên POS chưa">
      <bpmn:incoming>E2_F1</bpmn:incoming>
      <bpmn:outgoing>E2_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E2_Exists" name="Đơn đã lưu?">
      <bpmn:incoming>E2_F2</bpmn:incoming>
      <bpmn:outgoing>E2_Yes</bpmn:outgoing>
      <bpmn:outgoing>E2_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="E2_Temp" name="Ghi nhận thông tin đơn tạm">
      <bpmn:incoming>E2_No</bpmn:incoming>
      <bpmn:outgoing>E2_F4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="E2_Wait" name="POS hoạt động lại">
      <bpmn:incoming>E2_F4</bpmn:incoming>
      <bpmn:outgoing>E2_Retry</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="POS_Available_Condition">
        <bpmn:condition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">posHoatDongLai == true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="E2_Join" name="">
      <bpmn:incoming>E2_Main</bpmn:incoming>
      <bpmn:incoming>E2_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="E2_Main" name="" sourceRef="S09" targetRef="E2_Join" />
