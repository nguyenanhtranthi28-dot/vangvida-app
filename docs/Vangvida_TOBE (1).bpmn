<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Vangvida_TOBE" targetNamespace="https://vangvida.example/tobe" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_TOBE">
    <bpmn:participant id="Participant_TOBE" name="Quy trình bán hàng Vangvida — TO-BE" processRef="Process_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TOBE" name="TO-BE Vangvida — 4 lane, 3 vai trò con người, 22 hoạt động" isExecutable="false">
    <bpmn:documentation>Mục 2.4: 22 hoạt động chính; ba lane con người (khách hàng, nhân viên cửa hàng, bộ phận gia công) và một lane Hệ thống &amp; AI. Bảy tác vụ tự động thuộc lane hệ thống; nhân viên chỉ thực hiện công việc thủ công và các xác nhận trên ứng dụng. Không có lane chủ cửa hàng. Nhân viên chỉ xét giảm tối đa 5%. Hai cổng gia công đọc cùng trường coGiaCong; không bốc xác suất độc lập. Giữ đo ni và gia công thủ công. Không dùng timer chờ cứng sau gia công; thông báo sau kiểm tra đạt và chờ khách thực tế đến. Các sơ đồ ngoại lệ mục 2.3 là tài liệu tham chiếu: lỗi POS tại T09, nhắc quá hạn trong gia công T13 và hủy đơn trước bàn giao. Bản này mô hình hóa luồng chính và các vòng bổ sung cọc/sửa sản phẩm/bổ sung thanh toán; chưa gắn tham số hoặc chạy BIMP TO-BE.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_TOBE">
      <bpmn:lane id="Lane_workshop" name="Bộ phận gia công">
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_system" name="Hệ thống &#38; AI">
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0oyxdav</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_staff" name="Nhân viên cửa hàng">
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDiscount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JDiscount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GQuoteCustom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GCustom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDeposit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ANDSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ANDJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T21</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_customer" name="Khách hàng">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GAccept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CustomerArrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndYes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Nhu cầu mua trang sức">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T01" name="T01 · Cung cấp nhu cầu và ngân sách">
      <bpmn:documentation>Khách cho biết loại trang sức, ngân sách, yêu cầu ni và nhu cầu điều chỉnh nếu đã biết.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T02" name="T02 · AI Agent tra cứu và gợi ý mẫu">
      <bpmn:documentation>Agent gọi dữ liệu danh mục, giá và tồn kho POS; dùng nhu cầu khách để đề xuất mẫu còn khả dụng hoặc mẫu có thể điều chỉnh. Giá và tồn lấy từ dữ liệu xác thực, không do mô hình ngôn ngữ tự đặt. Lỗi hoặc gợi ý không phù hợp được nhân viên kiểm tra và tra cứu thủ công trong T03.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="T04" name="T04 · Thử mẫu, xem giá và đề nghị giảm">
      <bpmn:documentation>Khách thử mẫu, xem giá niêm yết từ POS và nêu đề nghị giảm giá nếu có.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T03" name="T03 · Kiểm tra gợi ý, tư vấn và đo ni">
      <bpmn:documentation>Nhân viên kiểm tra gợi ý của Agent, tư vấn, đo ni thủ công và đưa mẫu cho khách thử. Gộp các thao tác nhỏ cùng người thực hiện thành một hoạt động; giữ thời gian thao tác thực tế khi so sánh định lượng.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GDiscount" name="Khách yêu cầu giảm giá?" gatewayDirection="Diverging">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T05" name="T05 · Xét mức giảm trong hạn mức 5%">
      <bpmn:documentation>Nhân viên quyết định mức giảm từ 0 đến 5% trong thẩm quyền. Không mặc định giảm đủ 5% cho mọi khách. Bản này không mở rộng bước chủ cửa hàng phê duyệt trên 5%; hệ thống không tự duyệt mức vượt quyền.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="JDiscount" name="" gatewayDirection="Converging">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GQuoteCustom" name="Cần gia công thêm?" gatewayDirection="Diverging">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="JQuote" name="" gatewayDirection="Converging">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>Flow_0ucbzya</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T06" name="T06 · Xác nhận phí và hạn gia công">
      <bpmn:documentation>Thợ xem yêu cầu, tình trạng ni và lịch làm việc 08:00–18:00; xác nhận khả năng thực hiện, phí và thời điểm hoàn thành trước khi khách chốt và nộp cọc. Đây là trách nhiệm nghiệp vụ đã xác minh, được làm rõ trong to-be. Giả định luồng này áp dụng cho đơn xưởng có thể nhận; trường hợp không thể nhận xử lý như ngoại lệ/thương lượng lại.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="DQuote" name="Báo giá và lịch hẹn" dataObjectRef="DQuote_Object" />
    <bpmn:dataObject id="DQuote_Object" />
    <bpmn:userTask id="T08" name="T08 · Chốt tổng giá, lịch hẹn và thông tin">
      <bpmn:documentation>Khách xem tổng báo giá; xác nhận phương án, lịch hẹn nếu có gia công và thông tin liên hệ/đơn. Chỉ tạo đơn sau khi khách chấp thuận. Các trường thông tin dùng lại để tránh nhân viên nhập lại.</bpmn:documentation>
      <bpmn:incoming>Flow_1m4b3m4</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GAccept" name="Khách chốt đơn?" gatewayDirection="Diverging">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T09" name="T09 · Lưu đơn POS và giữ hàng">
      <bpmn:documentation>Lưu một lần thông tin khách và đơn được chấp thuận; giữ hàng hoặc hàng nền cần điều chỉnh để hạn chế bán trùng. Dùng mã đơn duy nhất khi đồng bộ và thử lại. Áp dụng xử lý lỗi POS tại mục 2.3 khi triển khai.</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0ibk0l4">
        <bpmn:targetRef>DOrder</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DOrder" name="Đơn POS / giữ hàng" dataObjectRef="DOrder_Object" />
    <bpmn:dataObject id="DOrder_Object" />
    <bpmn:exclusiveGateway id="GCustom" name="Đơn có gia công?" gatewayDirection="Diverging">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T10" name="T10 · Thanh toán tiền cọc">
      <bpmn:documentation>Khách nộp cọc theo phương án đã chấp thuận bằng tiền mặt hoặc QR. Tiền cọc chưa được coi là đã nhận cho đến T11 xác nhận.</bpmn:documentation>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndNo" name="Kết thúc tư vấn / chưa chốt đơn">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T11" name="T11 · Đối soát và xác nhận tiền cọc">
      <bpmn:documentation>Nhân viên kiểm tra chứng từ hoặc tiền thực nhận, đúng mã đơn và khoản cọc yêu cầu. Ghi nhận cả lần nộp bổ sung để tránh thu trùng. Chỉ phát lệnh gia công khi đã xác nhận đủ cọc.</bpmn:documentation>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GDeposit" name="Đã nhận đủ cọc?" gatewayDirection="Diverging">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T12" name="T12 · Chuyển phiếu gia công điện tử">
      <bpmn:documentation>Tự chuyển đúng mã đơn, yêu cầu kỹ thuật, cọc xác nhận và thời hạn do thợ đã thống nhất. Không dùng chuyển phiếu để tự thay đổi giá hoặc lời hẹn. Không cần gọi thợ xuống chỉ để truyền đạt lại thông tin.</bpmn:documentation>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DWork" name="Phiếu gia công" dataObjectRef="DWork_Object" />
    <bpmn:dataObject id="DWork_Object" />
    <bpmn:manualTask id="T13" name="T13 · Gia công và cập nhật hoàn thành">
      <bpmn:documentation>Thợ thực hiện và cập nhật trạng thái hoàn thành. Thời gian gia công thực tế hiện chốt là 10 giờ/đơn; 3 thợ làm 08:00–18:00. AI không được giả định làm giảm 600 phút lao động này. Khi kiểm tra không đạt thì quay lại xử lý, thời gian làm lại phải đo riêng.</bpmn:documentation>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T14" name="T14 · Kiểm tra sản phẩm hoàn thiện">
      <bpmn:documentation>Nhân viên nhận và kiểm tra ni, mẫu, chất lượng theo yêu cầu đơn. Chỉ hàng đạt mới được thông báo sẵn sàng; hàng không đạt quay về thợ sửa.</bpmn:documentation>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GQuality" name="Sản phẩm đạt yêu cầu?" gatewayDirection="Diverging">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T15" name="T15 · Thông báo hàng sẵn sàng cho khách">
      <bpmn:documentation>Gửi thông báo qua kênh liên hệ đã thống nhất sau khi sản phẩm qua kiểm tra. Thay bước chờ cứng 1 ngày sau gia công; thời gian khách thực tế đến nhận vẫn được giữ ở sự kiện kế tiếp.</bpmn:documentation>
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="CustomerArrives" name="Khách đến nhận hàng">
      <bpmn:documentation>Sự kiện điều kiện: khách đã đến nhận đơn gia công. Có thể phát sinh ngay nếu khách chờ tại cửa hàng; không mặc định khách quay lại ngay khi được nhắn. Không chiếm nhân viên/thợ trong thời gian khách chưa đến.</bpmn:documentation>
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Condition_CustomerArrives">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">khachDaDenNhanHang = true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="JGoods" name="" gatewayDirection="Converging">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ANDSplit" name="" gatewayDirection="Diverging">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T17" name="T17 · Chuẩn bị hóa đơn từ đơn POS">
      <bpmn:documentation>Hệ thống tạo dự thảo/chứng từ thanh toán từ dữ liệu đơn; chưa đánh dấu đã thanh toán. Hoạt động này độc lập với đóng gói. Chứng từ chính thức được chốt ở T20 sau đối soát.</bpmn:documentation>
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="T16" name="T16 · Đóng gói sản phẩm">
      <bpmn:documentation>Nhân viên đóng gói khi hàng có sẵn hoặc hàng gia công đã sẵn sàng. Thực hiện song song với hệ thống chuẩn bị hóa đơn, không giả định cùng một nhân viên làm hai thao tác thủ công đồng thời.</bpmn:documentation>
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="ANDJoin" name="" gatewayDirection="Converging">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="T18" name="T18 · Thanh toán số tiền còn lại">
      <bpmn:documentation>Thanh toán phần còn phải trả sau khi trừ cọc đã xác nhận. Nếu số dư bằng 0 thì xác nhận đã thanh toán đủ, không thu thêm.</bpmn:documentation>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T19" name="T19 · Đối soát và xác nhận thanh toán">
      <bpmn:documentation>Kiểm tra mã đơn, số tiền thực thu và chứng từ tiền mặt/QR. Với tiền mặt tính cả tiền trả lại; với QR kiểm tra số tiền được ghi nhận. Sai hoặc thiếu tiền quay lại khách bổ sung, chưa bàn giao hàng.</bpmn:documentation>
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GPayment" name="Đã nhận đúng số tiền?" gatewayDirection="Diverging">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T20" name="T20 · Chốt đơn, kho và báo cáo tự động">
      <bpmn:documentation>Sau xác nhận thanh toán, chuyển đơn sang đã thanh toán, chốt xuất kho từ hàng đã giữ, ghi nhận cọc để không trừ hai lần, phát hành/gửi chứng từ theo chính sách cửa hàng và cập nhật báo cáo nội bộ từ dữ liệu giao dịch. Thay chụp ảnh gửi thủ công; các cập nhật cần nhất quán và thử lại không tạo trùng.</bpmn:documentation>
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F42</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_19n72n5">
        <bpmn:targetRef>DReport</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DReport" name="Giao dịch và báo cáo" dataObjectRef="DReport_Object" />
    <bpmn:dataObject id="DReport_Object" />
    <bpmn:manualTask id="T21" name="T21 · Kiểm tra và bàn giao sản phẩm">
      <bpmn:documentation>Kiểm tra khớp mã đơn, sản phẩm và trạng thái thanh toán; bàn giao hàng cho khách.</bpmn:documentation>
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T22" name="T22 · Kiểm tra và nhận sản phẩm">
      <bpmn:documentation>Khách đối chiếu sản phẩm và nhận hàng/chứng từ. Hoàn tất đơn sau bàn giao.</bpmn:documentation>
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndYes" name="Hoàn tất mua hàng">
      <bpmn:incoming>F44</bpmn:incoming>
    </bpmn:endEvent>
